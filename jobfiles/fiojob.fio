[global]
time_based
runtime=300
startdelay=20
ramp_time=10
direct=1
size=450G
numjobs=1
iodepth=1
ioengine=libaio
write_bw_log=fio-test
write_lat_log=fio-test
write_iops_log=fio-test
log_avg_msec=1000
filename=/myvol/testfile
group_reporting=1

[write-4k]
bs=4k
rw=write
wait_for_previous=1
[randwrite-4k]
bs=4k
rw=randwrite
wait_for_previous=1
[read-4k]
bs=4k
rw=read
wait_for_previous=1
[randread-4k]
bs=4k
rw=randread
wait_for_previous=1
[write-8k]
bs=8k
rw=write
wait_for_previous=1
[randwrite-8k]
